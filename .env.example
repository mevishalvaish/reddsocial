# ==============================================================================
# ReddSocial Coming Soon - Environment Configuration
# ==============================================================================
# The Coming Soon page works out of the box. 
# When no email provider credentials are provided, the signup form provides 
# a transparent, honest notification explaining that subscription service 
# setup is pending, preventing lost emails or false positives.
#
# Choose ONE of the following integrations to activate live notifications:

# --- Option 1: Resend (Recommended) ---
# Sign up at https://resend.com and obtain an API key and Audience ID
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# --- Option 2: Mailchimp ---
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=us1
# MAILCHIMP_AUDIENCE_ID=

# --- Option 3: ConvertKit / Kit ---
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=

# --- Option 4: Custom Webhook (Zapier / Make / Slack / Discord / Custom CRM) ---
# SIGNUP_WEBHOOK_URL=

# --- Site URL (Used for Canonical Metadata and OpenGraph) ---
NEXT_PUBLIC_SITE_URL=https://reddsocial.com
